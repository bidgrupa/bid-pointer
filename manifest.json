{
  "manifest_version": 3,
  "name": "bid Pointer",
  "version": "1.0.0",
  "description": "Click anything on a website, say what's wrong, and get a ClickUp task with a marked-up screenshot.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "bid Pointer — toggle point mode (Alt+Shift+P)"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "detector.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "gmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.hubspot.com/*",
        "https://app-eu1.hubspot.com/*"
      ],
      "js": [
        "hubspot.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.otf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-point-mode": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle Pointer point mode"
    }
  }
}
